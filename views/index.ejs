<body>
    <div class="wrapper">
        <div class="menu">
            <span><a href="">Home</a></span>
            <span><a href="profile">Profile</a></span>
            <% if (data.role_id==3 ) { %>
                <span><a href="report">Report</a></span>
                <% } else if (data.role_id==2) { %>
