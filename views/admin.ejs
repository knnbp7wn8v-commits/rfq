<script>
    document.addEventListener("DOMContentLoaded", function() {
      // Itt írd meg a lapozó (vagy egyéb) scriptet
      var rows = document.querySelectorAll("#portfolio tbody tr");
      var rowsPerPage = 50;
      var currentPage = 1;
      var totalRows = rows.length;
      var totalPages = Math.ceil(totalRows / rowsPerPage);
  
      function displayPage(page) {
        currentPage = page;
        var start = (page - 1) * rowsPerPage;
        var end = start + rowsPerPage;
        
        rows.forEach(function(row, index) {
          row.style.display = (index >= start && index < end) ? "" : "none";
        });
  
        document.getElementById("page-info").textContent = "Oldal " + page + " / " + totalPages;
      }
  
      document.getElementById("prev-page").addEventListener("click", function() {
        if (currentPage > 1) {
          displayPage(currentPage - 1);
        }
      });
  
      document.getElementById("next-page").addEventListener("click", function() {
        if (currentPage < totalPages) {
          displayPage(currentPage + 1);
        }
      });
  
      displayPage(1);
    });
  </script>
</body>
<script>
    let timeout = null;
    var s1 = document.getElementById('s1').value;
    var s2 = document.getElementById('s2').value;
    var s3 = document.getElementById('s3').value;
    function filter(from) {
        const s = this;

        s1 = document.getElementById('s1').value;
        s2 = document.getElementById('s2').value;
        s3 = document.getElementById('s3').value;
        const data = {
            head: "filter",
            data: {
                s1: s1,
                s2: s2,
                s3: s3
            }
        }
        var str = "";
        var qry = "";
        var target = "";
        fetch('/mw', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        }).then(response => response.json())
            .then(data => {
                portfolio_render(data.data);
                document.getElementById("portfolio_nr").innerHTML = (data.data).length;
                showMessage(data.message, 'success');
            })
            .catch(error => console.error('Error:', error));

    }
    function handleKeyUp() {
        clearTimeout(timeout);
        timeout = setTimeout(function () {
            filter();
        }, 1000);
    }
    document.getElementById("s1").addEventListener('keyup', handleKeyUp);
    document.getElementById("s2").addEventListener('keyup', handleKeyUp);
    document.getElementById("s3").addEventListener('keyup', handleKeyUp);
    document.querySelectorAll('.add').forEach(item => {
        item.addEventListener('click', function (e) {
            var str = "";
            var qry = "";
            var target = "";
            if (e.srcElement.id == "tissue_add") {
                target = "portfolio";
                const s_tissue = document.querySelectorAll('#tissues option:checked');
                const s_reel = document.querySelectorAll('#reels option:checked');
                const s_gramm = document.querySelectorAll('#grammatura option:checked');
                for (i = 0; i < s_reel.length; i++) {
                    for (j = 0; j < s_gramm.length; j++) {
                        str = str + "('" + s_tissue[0].value + "', " + s_reel[i].value + ", " + s_gramm[j].value + "), ";
                    }
                }
                str = str.substring(0, str.length - 2);
                qry = "INSERT into portfolio (tissue, reel, grammatura) VALUES " + str;
            } else if (e.srcElement.id == "plies_add") {
                target = "plie_param";
                const s_plies = document.querySelectorAll('#plies option:checked');
                const s_diam = document.querySelectorAll('#diameter option:checked');
                for (i = 0; i < s_diam.length; i++) {
                    str = str + "('" + s_plies[0].value + "', " + s_diam[i].value + "), ";
                }
                str = str.substring(0, str.length - 2);
                qry = "INSERT into plie_param (plie, diameter) VALUES " + str;
            } else if (e.srcElement.id == "ediamater_add") {
                target = "ediam_param";
                const s_height = document.querySelectorAll('#height option:checked');
                const s_truck = document.querySelectorAll('#truck option:checked');
                const s_tis2 = document.querySelectorAll('#tissues2 option:checked');
                const s_weight = document.querySelectorAll('#weight option:checked');
                for (i = 0; i < s_truck.length; i++) {
                    for (j = 0; j < s_tis2.length; j++) {
                        for (g = 0; g < s_weight.length; g++) {
                            str = str + "(" + s_height[0].value + ", '" + s_truck[i].value + "', '" + s_tis2[j].value + "', " + s_weight[g].value + "), ";
                        }
                    }
                }
                str = str.substring(0, str.length - 2);
                qry = "INSERT into ediam_param (eheight, truck, tissue, weight) VALUES " + str;
            }
            fetch('/mw/{"head":"add", "target":"' + target + '", "data":"' + qry + '"}', { method: 'GET' })
                .then(function (response) {
                    return response.json()
                })
                .then(function (data) {
                    time = Math.trunc(JSON.parse(data).time / 1000);
                    update();
                    switch (e.srcElement.id) {
                        case "tissue_add":
                            portfolio_render(JSON.parse(data).data);
                            break;
                        case "plies_add":
                            plie_param_render(JSON.parse(data).data);
                            break;
                        case "ediamater_add":
                            ediam_param_render(JSON.parse(data).data);
                            break;

                    }
                })
                .catch(function (error) {
                    console.log(error);
                });
        })
    });


    document.querySelectorAll('.del').forEach(item => {
        item.addEventListener('click', function (e) {
            var qry = "";
            var str = "";
            var target = "";
            if (e.srcElement.id == "btn2") {
                target = "portfolio";
                const ids = document.querySelectorAll('#portfolio input[type="checkbox"]:checked');
                ids.forEach(function (el) {
                    if (el.id != "selectall") {
                        str = str + "'" + el.id + "', ";
                    }
                })
                str = str.substring(0, str.length - 2);
                qry = "DELETE from portfolio WHERE id IN (" + str + ")";
            } else if (e.srcElement.id == "plies_del") {
                target = "plie_param";
                const ids = document.querySelectorAll('#plie_params input[type="checkbox"]:checked');
                ids.forEach(function (el) {
                    if (el.id != "selectall") {
                        str = str + "'" + el.id + "', ";
                    }
                    str = str.substring(0, str.length - 2);
                    qry = "DELETE from plie_param WHERE id IN (" + str + ")";
                })
            } else if (e.srcElement.id == "ediam_del") {
                target = "ediam_param";
                const ids = document.querySelectorAll('#ediam_params input[type="checkbox"]:checked');
                ids.forEach(function (el) {
                    if (el.id != "selectall") {
                        str = str + "'" + el.id + "', ";
                    }
                    str = str.substring(0, str.length - 2);
                    qry = "DELETE from ediam_param WHERE id IN (" + str + ")";
                })
            }
            fetch('/mw/{"head":"delete", "target":"' + target + '", "data":"' + qry + '"}', { method: 'GET' })
                .then(function (response) {
                    return response.json()
                })
                .then(function (data) {
                    switch (e.srcElement.id) {
                        case "btn2":
                            portfolio_render(JSON.parse(data).data);
                            break;
                        case "plies_del":
                            plie_param_render(JSON.parse(data).data);
                            break;
                        case "ediam_del":
                            ediam_param_render(JSON.parse(data).data);
                            break;
                    }
                    console.log(JSON.parse(data).message);
                })
                .catch(function (error) {
                    console.log(error);
                });
        })
    });
