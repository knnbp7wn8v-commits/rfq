<!-- A script a body végén -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
      // Itt írd meg a lapozó (vagy egyéb) scriptet
      var rows = document.querySelectorAll("#portfolio tbody tr");
      var rowsPerPage = 50;
      var currentPage = 1;
      var totalRows = rows.length;
      var totalPages = Math.ceil(totalRows / rowsPerPage);
  
      function displayPage(page) {
        currentPage = page;
        var start = (page - 1) * rowsPerPage;
        var end = start + rowsPerPage;
        
        rows.forEach(function(row, index) {
          row.style.display = (index >= start && index < end) ? "" : "none";
        });
  
        document.getElementById("page-info").textContent = "Oldal " + page + " / " + totalPages;
      }
  
      document.getElementById("prev-page").addEventListener("click", function() {
        if (currentPage > 1) {
          displayPage(currentPage - 1);
        }
      });
  
      document.getElementById("next-page").addEventListener("click", function() {
        if (currentPage < totalPages) {
          displayPage(currentPage + 1);
        }
      });
  
      displayPage(1);
    });
  </script>
</body>
<script>
    let timeout = null;
    var s1 = document.getElementById('s1').value;
    var s2 = document.getElementById('s2').value;
    var s3 = document.getElementById('s3').value;
    function filter(from) {
        s1 = document.getElementById('s1').value;
        s2 = document.getElementById('s2').value;
        s3 = document.getElementById('s3').value;
        const data = {
            head: "filter",
            data: {
                s1: s1,
                s2: s2,
                s3: s3
            }
        }
        fetch('/mw', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        }).then(checkResponse)
            .then(data => {
                portfolio_render(data.data);
                document.getElementById("portfolio_nr").innerHTML = (data.data).length;
                showMessage(data.message, 'success');
            })
            .catch(error => {
                Logger.error('Portfólió szűrése sikertelen:', error);
                showMessage(error.message || 'Hiba történt a szűrés során.', 'error');
            });

    }
    function handleKeyUp() {
        clearTimeout(timeout);
        timeout = setTimeout(function () {
            filter();
        }, 1000);
    }
    document.getElementById("s1").addEventListener('keyup', handleKeyUp);
    document.getElementById("s2").addEventListener('keyup', handleKeyUp);
    document.getElementById("s3").addEventListener('keyup', handleKeyUp);
    document.querySelectorAll('.add').forEach(item => {
        item.addEventListener('click', function (e) {
            // Megjegyzés: korábban itt egy teljes SQL INSERT utasítás lett
            // szövegként összeállítva és elküldve a szervernek, amit az
            // validáció nélkül futtatott le - ez SQL injection-t tett
            // lehetővé. Mostantól csak strukturált adatot (target + sorok)
            // küldünk, a lekérdezést a szerver állítja össze egy
            // fehérlistázott tábla-/oszlopdefiníció alapján.
            var target = "";
            var rows = [];
            if (e.srcElement.id == "tissue_add") {
                target = "portfolio";
                const s_tissue = document.querySelectorAll('#tissues option:checked');
                const s_reel = document.querySelectorAll('#reels option:checked');
                const s_gramm = document.querySelectorAll('#grammatura option:checked');
                for (let i = 0; i < s_reel.length; i++) {
                    for (let j = 0; j < s_gramm.length; j++) {
                        rows.push({ tissue: s_tissue[0].value, reel: Number(s_reel[i].value), grammatura: Number(s_gramm[j].value) });
                    }
                }
            } else if (e.srcElement.id == "plies_add") {
                target = "plie_param";
                const s_plies = document.querySelectorAll('#plies option:checked');
                const s_diam = document.querySelectorAll('#diameter option:checked');
                for (let i = 0; i < s_diam.length; i++) {
                    rows.push({ plie: s_plies[0].value, diameter: Number(s_diam[i].value) });
                }
            } else if (e.srcElement.id == "ediamater_add") {
                target = "ediam_param";
                const s_height = document.querySelectorAll('#height option:checked');
                const s_truck = document.querySelectorAll('#truck option:checked');
                const s_tis2 = document.querySelectorAll('#tissues2 option:checked');
                const s_weight = document.querySelectorAll('#weight option:checked');
                for (let i = 0; i < s_truck.length; i++) {
                    for (let j = 0; j < s_tis2.length; j++) {
                        for (let g = 0; g < s_weight.length; g++) {
                            rows.push({ eheight: Number(s_height[0].value), truck: s_truck[i].value, tissue: s_tis2[j].value, weight: Number(s_weight[g].value) });
                        }
                    }
                }
            }
            if (!target || rows.length === 0) {
                return;
            }
            fetch('/mw/' + encodeURIComponent(JSON.stringify({ head: "add", target: target, data: rows })), { method: 'GET' })
                .then(checkResponse)
                .then(function (data) {
                    // Megjegyzés: itt korábban egy "update();" hívás állt, holott
                    // sehol nem létezett ilyen nevű függvény a kódbázisban - ez
                    // minden sikeres hozzáadás után egy el nem kapott
                    // ReferenceError-t dobott, ami megszakította ennek a .then()
                    // ágnak a lefutását: sem a táblázat (portfolio_render stb.)
                    // nem frissült, sem a sikeres mentésről szóló üzenet nem
                    // jelent meg - a felhasználó helyette egy hibaüzenetet
                    // látott, miközben a szerveroldali beszúrás valójában
                    // sikeres volt. A hívás - egy hasonlóan hasznon kívüli
                    // "time = Math.trunc(data.time / 1000);" sorral együtt,
                    // amelynek eredményét semmi nem használta fel - törölve.
                    switch (e.srcElement.id) {
                        case "tissue_add":
                            portfolio_render(data.data);
                            // Az elemszám-számláló korábban csak a filter()
                            // függvényben frissült, hozzáadás után nem - így
                            // sikeres mentés után is a régi (eggyel kisebb)
                            // érték maradt látható a "Portfolio (N tétel)"
                            // fejlécben, amíg a felhasználó nem szűrt.
                            document.getElementById("portfolio_nr").innerHTML = (data.data).length;
                            break;
                        case "plies_add":
                            plie_param_render(data.data);
                            break;
                        case "ediamater_add":
                            ediam_param_render(data.data);
                            break;

                    }
                    showMessage(data.message, 'success');
                })
                .catch(function (error) {
                    Logger.error('Sor hozzáadása sikertelen:', error);
                    showMessage(error.message || 'Hiba történt a sor hozzáadása során.', 'error');
                });
        })
    });


    document.querySelectorAll('.del').forEach(item => {
        item.addEventListener('click', function (e) {
            // Megjegyzés: korábban itt egy teljes SQL DELETE utasítás lett
            // szövegként összeállítva (validáció/escaping nélkül) - lásd a
            // fenti '.add' kezelőnél írt megjegyzést. Mostantól csak a
            // törlendő azonosítók (szám) listáját küldjük.
            var target = "";
            var ids = [];
            if (e.srcElement.id == "btn2") {
                target = "portfolio";
                document.querySelectorAll('#portfolio input[type="checkbox"]:checked').forEach(function (el) {
                    if (el.id != "selectall") {
                        ids.push(Number(el.id));
                    }
                })
            } else if (e.srcElement.id == "plies_del") {
                target = "plie_param";
                document.querySelectorAll('#plie_params input[type="checkbox"]:checked').forEach(function (el) {
                    if (el.id != "selectall") {
                        ids.push(Number(el.id));
                    }
                })
            } else if (e.srcElement.id == "ediam_del") {
                target = "ediam_param";
                document.querySelectorAll('#ediam_params input[type="checkbox"]:checked').forEach(function (el) {
                    if (el.id != "selectall") {
                        ids.push(Number(el.id));
                    }
                })
            }
            if (!target || ids.length === 0) {
                return;
            }
            fetch('/mw/' + encodeURIComponent(JSON.stringify({ head: "delete", target: target, data: ids })), { method: 'GET' })
                .then(checkResponse)
                .then(function (data) {
                    switch (e.srcElement.id) {
                        case "btn2":
                            portfolio_render(data.data);
                            break;
                        case "plies_del":
                            plie_param_render(data.data);
                            break;
                        case "ediam_del":
                            ediam_param_render(data.data);
                            break;
                    }
                    Logger.info('Sor törlése sikeres:', data.message);
                    showMessage(data.message, 'success');
                })
                .catch(function (error) {
                    Logger.error('Sor törlése sikertelen:', error);
                    showMessage(error.message || 'Hiba történt a sor törlése során.', 'error');
                });
        })
    });
    document.getElementById("s4").addEventListener('keyup', handleKeyUp2);
    document.getElementById("s5").addEventListener('keyup', handleKeyUp2);
    document.getElementById("s6").addEventListener('keyup', handleKeyUp2);
    document.getElementById("s7").addEventListener('keyup', handleKeyUp2);
    document.getElementById("s8").addEventListener('keyup', handleKeyUp2);
    document.getElementById("s9").addEventListener('keyup', handleKeyUp2);
    document.getElementById("s10").addEventListener('keyup', handleKeyUp2);
    document.getElementById("s11").addEventListener('keyup', handleKeyUp2);

    function fakeuser() {
        fetch('/test/{"head":"fakeuser"}', { method: 'GET' })
            .then(checkResponse)
            .then(function (data) {
                showMessage(data.message, 'success');
            })
            .catch(function (error) {
                Logger.error('Teszt felhasználó generálása sikertelen:', error);
                showMessage(error.message || 'Hiba történt a teszt felhasználó generálása során.', 'error');
            });
    }
    function fakerfq() {
        fetch('/test/{"head":"fakerfq"}', { method: 'GET' })
            .then(checkResponse)
            .then(function (data) {
                showMessage(data.message, 'success');
            })
            .catch(function (error) {
                Logger.error('Teszt RFQ generálása sikertelen:', error);
                showMessage(error.message || 'Hiba történt a teszt RFQ generálása során.', 'error');
            });
    }
</script>

