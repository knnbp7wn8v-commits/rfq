<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="css/style.css" />
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap">
    <link rel="stylesheet" type="text/css" href="css/modern-shared.css" />
    <link rel="stylesheet" type="text/css" href="css/admin-modern.css" />
    <title>Request for Order</title>
    <script src="assets/scripts/admin.js"></script>
    <script src="assets/scripts/common.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/emailjs-com@2.4.0/dist/email.min.js"></script>
    <script>
        var test = "<%= data[11].rows[0].customer_id %>";
    </script>
    <style>
        select {
            height: auto !important;
        }
    </style>
</head>

<body>
    <div class="wrapper">
    <div class="menu modern-ui">
        <div class="topnav">
            <div class="topnav-left">
                <div class="brand">
                    <svg class="brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"></circle>
                        <circle cx="12" cy="12" r="4"></circle>
                    </svg>
                    <span class="brand-name">RFQ</span>
                </div>
                <nav class="nav-links">
                    <a class="nav-link" href="protected">Home</a>
                    <a class="nav-link" href="profile">Profile</a>
                    <% if (data[11].rows[0].role_id==3 ) { %>
                        <a class="nav-link" href="report">Report</a>
                        <% } else if (data[11].rows[0].role_id==2) { %>
                            <a class="nav-link" href="report">Report</a>
                            <% } %>
                    <% if (data[11].rows[0].role_id==3) { %>
                        <a class="nav-link active" href="admin">Admin</a>
                        <% } %>
                </nav>
            </div>
            <div class="topnav-right">
                <div class="user-chip">
                    <span class="avatar"><%= (data[11].rows[0].customer_name || '?').trim().charAt(0).toUpperCase() %></span>
                    <span class="user-name" id="name">Welcome back: <strong><%= data[11].rows[0].customer_name %></strong></span>
                </div>
            </div>
        </div>
    </div>
    <div class="tab modern-ui">
        <div class="subnav">
            <button class="tablinks subnav-tab active" onclick="openTab(event, 'Portfolios')">Portfolio</button>
            <button class="tablinks subnav-tab" onclick="openTab(event, 'Parameters')">Parameters</button>
            <button class="tablinks subnav-tab" onclick="openTab(event, 'Others')">Others</button>
            <button class="tablinks subnav-tab" onclick="openTab(event, 'Customers')">Customers</button>
            <button class="tablinks subnav-tab" onclick="openTab(event, 'Requests')">Requests</button>
            <button class="tablinks subnav-tab" onclick="openTab(event, 'Test')">Test</button>
        </div>
    </div>
    <div id="Portfolios" class="tabcontent modern-ui" style="display: flex !important;">
        <div id="div_1" class="p-sidebar">

            <div class="filter-group">
                <div class="filter-title">Tissues</div>
                <div class="filter-list" id="tissues-filter-list">
                    <% data[0].rows.forEach(function(tissue, idx) { %>
                        <label class="filter-row">
                            <input type="radio" name="tissue-radio" data-option-index="<%= idx %>" <%= idx === 0 ? 'checked' : '' %>>
                            <span class="filter-row-label"><%= tissue.tissue %></span>
                        </label>
                        <% }); %>
                </div>
                <select id="tissues" size="5" class="shadow-select" aria-hidden="true" tabindex="-1">
                    <% data[0].rows.forEach(function(tissue) { %>
                        <option value="<%= tissue.tissue %>">
                            <%= tissue.tissue %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div class="filter-group">
                <div class="filter-title">Reels</div>
                <div class="filter-list" id="reels-filter-list">
                    <% data[2].rows.forEach(function(r, idx) { %>
                        <label class="filter-row">
                            <input type="checkbox" data-option-index="<%= idx %>">
                            <span class="filter-row-label"><%= r.reels %></span>
                        </label>
                        <% }); %>
                </div>
                <select id="reels" multiple size="10" class="shadow-select" aria-hidden="true" tabindex="-1">
                    <% data[2].rows.forEach(function(r) { %>
                        <option value="<%= r.reels %>">
                            <%= r.reels %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div class="filter-group">
                <div class="filter-title">Grammatura</div>
                <div class="filter-list" id="grammatura-filter-list">
                    <% data[1].rows.forEach(function(gr, idx) { %>
                        <label class="filter-row">
                            <input type="checkbox" data-option-index="<%= idx %>">
                            <span class="filter-row-label"><%= gr.grammatura %> gsm</span>
                        </label>
                        <% }); %>
                </div>
                <select id="grammatura" multiple size="10" class="shadow-select" aria-hidden="true" tabindex="-1">
                    <% data[1].rows.forEach(function(gr) { %>
                        <option value="<%= gr.grammatura %>">
                            <%= gr.grammatura %> gsm
                        </option>
                        <% }); %>
                </select>
            </div>

            <button id="tissue_add" class="add btn-primary" style="margin-top:auto;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add
            </button>
        </div>
        <div id="div_2" class="p-content">
            <div id="div_2a" class="table-card">
                <div class="content-head" style="padding: 18px 18px 0;">
                    <div class="content-title">
                        <h1>Portfolio</h1>
                        <span class="count">(<span id="portfolio_nr"><%= data[3].rowCount %></span> tétel)</span>
                    </div>
                    <div class="head-actions">
                        <button id="btn2" class="del btn-ghost">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            Delete
                        </button>
                    </div>
                </div>
                <table id="portfolio" class="data-table">
                    <thead>
                    <tr>
                        <th class="th-select"><input type="checkbox" id="selectall" value="portfolio"
                                onchange="selectall(this)" /></th>
                        <th>
                            <span class="th-label">Tissue</span>
                            <span class="th-search">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <input type="search" id="s1" name="q" placeholder="Tissue filter"
                                    aria-label="Search through site content" />
                            </span>
                        </th>
                        <th>
                            <span class="th-label">Reel</span>
                            <span class="th-search">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <input type="search" id="s2" name="q" placeholder="Reel filter"
                                    aria-label="Search through site content" />
                            </span>
                        </th>
                        <th>
                            <span class="th-label">Grammatura</span>
                            <span class="th-search">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <input type="search" id="s3" name="q" placeholder="Grammatura filter"
                                    aria-label="Search through site content" />
                            </span>
                        </th>
                    </tr>
                </thead>
                    <% data[3].rows.forEach(function(pr) { %>
                        <tr>
                            <td class="td-select"><input type="checkbox" id="<%= pr.id %>" /></td>
                            <td>
                                <span class="tissue-pill"><%= pr.tissue %></span>
                            </td>
                            <td>
                                <%= pr.reel %> cm
                            </td>
                            <td>
                                <%= pr.grammatura %> gsm
                            </td>
                        </tr>
                        <% }); %>
                </table>
                <!-- Lapozó vezérlők -->
                <div id="pagination-controls">
                    <button id="prev-page" aria-label="Előző oldal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
                    <span id="page-info"></span>
                    <button id="next-page" aria-label="Következő oldal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
                </div>
            </div>
        </div>
    </div>
    <div id="Parameters" class="tabcontent modern-ui content">
        <div class="params-grid">
        <div id="div_3" class="param-card">
            <div class="content-head">
                <div class="content-title"><h1>Plies and diameters</h1></div>
            </div>
            <div id="div_3a" class="param-form">
                <div class="field">
                    <label class="labelclass">Plie</label>
                    <select id="plies" size="5">
                        <% data[4].rows.forEach(function(pl) { %>
                            <option value="<%= pl.plie %>">
                                <%= pl.plie %>
                            </option>
                            <% }); %>
                    </select>
                </div>
                <div class="field">
                    <label class="labelclass">Diameter</label>
                    <select id="diameter" size="4" multiple>
                        <% data[5].rows.forEach(function(d) { %>
                            <option value="<%= d.diameter %>">
                                <%= d.diameter %> cm
                            </option>
                            <% }); %>
                    </select>
                </div>
                <button id="plies_add" class="add btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Add
                </button>
            </div>
            <div id="div_3b" class="param-table-wrap">
                <div id="div_3b1" class="table-card">
                    <table id="plie_params" class="data-table">
                        <tr>
                            <th>Select All<br><input type="checkbox" id="selectall" value="plie_params"
                                    onchange="selectall(this)" /></th>
                            <th>Plie</th>
                            <th>Diameter</th>
                        </tr>
                        <% data[6].rows.forEach(function(plp) { %>
                            <tr>
                                <td><input type="checkbox" id="<%= plp.id %>" /></td>
                                <td>
                                    <%= plp.plie %>
                                </td>
                                <td>
                                    <%= plp.diameter %> cm
                                </td>
                            </tr>
                            <% }); %>
                    </table>
                </div>
                <div id="div_3b2" class="head-actions">
                    <button id="plies_del" class="del btn-ghost">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        Delete
                    </button>
                </div>
            </div>
        </div>
        <div id="div_4" class="param-card">
            <div class="content-head">
                <div class="content-title"><h1>External diameter / Height</h1></div>
            </div>
            <div id="div_4a" class="param-form">
                <div class="field">
                    <label class="labelclass">Height</label>
                    <select id="height" size="5">
                        <% data[7].rows.forEach(function(h) { %>
                            <option value="<%= h.eheight %>">
                                <%= h.eheight %> cm
                            </option>
                            <% }); %>
                    </select>
                </div>
                <div class="field">
                    <label class="labelclass">Trucks</label>
                    <select id="truck" size="5" multiple>
                        <% data[8].rows.forEach(function(t) { %>
                            <option value="<%= t.truck %>">
                                <%= t.truck %>
                            </option>
                            <% }); %>
                    </select>
                </div>
                <div class="field">
                    <label class="labelclass">Tissues</label>
                    <select id="tissues2" size="5">
                        <% data[0].rows.forEach(function(tissue) { %>
                            <option value="<%= tissue.tissue %>">
                                <%= tissue.tissue %>
                            </option>
                            <% }); %>
                    </select>
                </div>
                <div class="field">
                    <label class="labelclass">Weight</label>
                    <select id="weight" size="5" multiple>
                        <% data[9].rows.forEach(function(w) { %>
                            <option value="<%= w.weight %>">
                                <%= w.weight %> kg
                            </option>
                            <% }); %>
                    </select>
                </div>
                <button id="ediamater_add" class="add btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    Add
                </button>
            </div>
            <div id="div_4b" class="param-table-wrap">
                <div id="div_4b1" class="table-card">
                    <table id="ediam_params" class="data-table">
                        <tr>
                            <th>Select All<br><input type="checkbox" id="selectall" value="ediam_params"
                                    onchange="selectall(this)" /></th>
                            <th>Height</th>
                            <th>Trucks</th>
                            <th>Tissue</th>
                            <th>Weight</th>
                        </tr>
                        <% data[10].rows.forEach(function(ed) { %>
                            <tr>
                                <td><input type="checkbox" id="<%= ed.id %>" /></td>
                                <td>
                                    <%= ed.eheight %> cm
                                </td>
                                <td>
                                    <%= ed.truck %>
                                </td>
                                <td>
                                    <%= ed.tissue %>
                                </td>
                                <td>
                                    <%= ed.weight %> kg
                                </td>
                            </tr>
                            <% }); %>
                    </table>
                </div>
                <div id="div_4b2" class="head-actions">
                    <button id="ediam_del" class="del btn-ghost">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        Delete
                    </button>
                </div>
            </div>
        </div>
        </div>
    </div>
    <div id="Others" class="tabcontent modern-ui content">
        <div class="ref-grid">
        <div id="div_o_1" class="ref-card">
            <div class="ref-list-block">
                <label class="labelclass selectlabel">Tissues</label>
                <select id="o_tissues" size="5">
                    <% data[0].rows.forEach(function(tissue) { %>
                        <option value="<%= tissue.tissue %>">
                            <%= tissue.tissue %>
                        </option>
                        <% }); %>
                </select>
                <div class="button-row">
                    <button id="o_tis_add" class="oadd">Add</button>
                    <button id="o_tis_del" class="odel">Delete</button>
                </div>
            </div>
            <div class="ref-list-block">
                <label class="labelclass selectlabel">Reels</label>
                <select id="o_reels" multiple size="10">
                    <% data[2].rows.forEach(function(r) { %>
                        <option value="<%= r.reels %>">
                            <%= r.reels %>
                        </option>
                        <% }); %>
                </select>
                <div class="button-row">
                    <button id="o_reel_add" class="oadd">Add</button>
                    <button id="o_reel_del" class="odel">Delete</button>
                </div>
            </div>
            <div class="ref-list-block">
                <label class="labelclass selectlabel">Grammatura</label>
                <select id="o_grammatura" multiple size="10">
                    <% data[1].rows.forEach(function(gr) { %>
                        <option value="<%= gr.grammatura %>">
                            <%= gr.grammatura %> gsm
                        </option>
                        <% }); %>
                </select>
                <div class="button-row">
                    <button id="o_gram_add" class="oadd">Add</button>
                    <button id="o_gram_del" class="odel">Delete</button>
                </div>
            </div>
        </div>
        <div id="div_o_2" class="ref-card">
            <div class="ref-list-block">
                <label class="labelclass">Plies</label>
                <select id="o_plies" size="5">
                    <% data[4].rows.forEach(function(pl) { %>
                        <option value="<%= pl.plie %>">
                            <%= pl.plie %>
                        </option>
                        <% }); %>
                </select>
                <div class="button-row">
                    <button id="o_pli_add" class="oadd">Add</button>
                    <button id="o_pli_del" class="odel">Delete</button>
                </div>
            </div>
            <div class="ref-list-block">
                <label class="labelclass">Diameters</label>
                <select id="o_diameter" size="4">
                    <% data[5].rows.forEach(function(d) { %>
                        <option value="<%= d.diameter %>">
                            <%= d.diameter %> cm
                        </option>
                        <% }); %>
                </select>
                <div class="button-row">
                    <button id="o_dia_add" class="oadd">Add</button>
                    <button id="o_dia_del" class="odel">Delete</button>
                </div>
            </div>
        </div>
        <div id="div_o_3" class="ref-card">
            <div class="ref-list-block">
                <label class="labelclass">External diameter Height</label>
                <select id="o_height" size="5">
                    <% data[7].rows.forEach(function(h) { %>
                        <option value="<%= h.eheight %>">
                            <%= h.eheight %> cm
                        </option>
                        <% }); %>
                </select>
                <div class="button-row">
                    <button id="o_hei_add" class="oadd">Add</button>
                    <button id="o_hei_del" class="odel">Delete</button>
                </div>
            </div>
            <div class="ref-list-block">
                <label class="labelclass">Trucks</label>
                <select id="o_truck" size="5" multiple>
                    <% data[8].rows.forEach(function(t) { %>
                        <option value="<%= t.truck %>">
                            <%= t.truck %>
                        </option>
                        <% }); %>
                </select>
                <div class="button-row">
                    <button id="o_tru_add" class="oadd">Add</button>
                    <button id="o_tru_del" class="odel">Delete</button>
                </div>
            </div>
            <div class="ref-list-block">
                <label class="labelclass">Weight</label>
                <select id="o_weight" size="5" multiple>
                    <% data[9].rows.forEach(function(w) { %>
                        <option value="<%= w.weight %>">
                            <%= w.weight %> kg
                        </option>
                        <% }); %>
                </select>
                <div class="button-row">
                    <button id="o_wei_add" class="oadd">Add</button>
                    <button id="o_wei_del" class="odel">Delete</button>
                </div>
            </div>
        </div>
        </div>
    </div>
    <div id="Customers" class="tabcontent modern-ui content">
        <div id="c_data" class="table-card">
            <div class="content-head" style="padding: 18px 18px 0;">
                <div class="content-title">
                    <h1>Customers</h1>
                    <span class="count">(<span id="customers_nr"><%= data[12].rowCount %></span>)</span>
                </div>
            </div>
            <table id="customers" class="data-table">
                <tr>
                    <th>
                        <span class="th-label">Customer Name</span>
                        <span class="th-search"><input type="search" id="s4" name="q" placeholder="Customer filter" aria-label="Search through site content" /></span>
                    </th>
                    <th>
                        <span class="th-label">VAT Number</span>
                        <span class="th-search"><input type="search" id="s5" name="q" placeholder="VAT filter" aria-label="Search through site content" /></span>
                    </th>
                    <th>
                        <span class="th-label">Contact Name</span>
                        <span class="th-search"><input type="search" id="s6" name="q" placeholder="Contact filter" aria-label="Search through site content" /></span>
                    </th>
                    <th>
                        <span class="th-label">Email</span>
                        <span class="th-search"><input type="search" id="s7" name="q" placeholder="Email filter" aria-label="Search through site content" /></span>
                    </th>
                    <th>
                        <span class="th-label">Phone</span>
                        <span class="th-search"><input type="search" id="s8" name="q" placeholder="Phone filter" aria-label="Search through site content" /></span>
                    </th>
                    <th>
                        <span class="th-label">Data Joined</span>
                        <span class="th-search"><input type="search" id="s9" name="q" placeholder="Date filter" aria-label="Search through site content" /></span>
                    </th>
                    <th>
                        <span class="th-label">Role</span>
                        <span class="th-search"><input type="search" id="s10" name="q" placeholder="Role filter" aria-label="Search through site content" /></span>
                    </th>
                    <th>
                        <span class="th-label">Status</span>
                        <span class="th-search"><input type="search" id="s11" name="q" placeholder="Status filter" aria-label="Search through site content" /></span>
                    </th>
                </tr>
                <% data[12].rows.forEach(function(pr) { %>
                    <tr id="<%= pr.customer_id %>" onclick='details("<%= pr.customer_id %>")'>
                        <td>
                            <%= pr.customer_name %>
                        </td>
                        <td>
                            <%= pr.vat_number %>
                        </td>
                        <td>
                            <%= pr.contact_name %>
                        </td>
                        <td>
                            <%= pr.email %>
                        </td>
                        <td>
                            <%= pr.phone %>
                        </td>
                        <td>
                            <%= pr.date_joined.toLocaleDateString('hu-HU', { year: 'numeric' , month: '2-digit' ,
                                day: '2-digit' }); %>
                        </td>
                        <td>
                            <%= pr.rolename %>
                        </td>
                        <td>
                            <%= pr.status %>
                        </td>
                    </tr>
                    <% }); %>
            </table>
        </div>
        <div id="c_details" class="detail-card"></div>
    </div>
    <div id="Requests" class="tabcontent modern-ui content">
        <div class="table-card">
            <div class="content-head" style="padding: 18px 18px 0;">
                <div class="content-title">
                    <h1>Requests</h1>
                    <span class="count">(<span id="requests_nr"><%= data[13].rowCount %></span>)</span>
                </div>
            </div>
            <table id="request" class="data-table">
                <tr>
                    <th><span class="th-label">Customer</span><span class="th-search"><input type="search" id="s20" name="q" placeholder="Customer filter"/></span></th>
                    <th><span class="th-label">Tissue</span><span class="th-search"><input type="search" id="s21" name="q" placeholder="Tissue filter"/></span></th>
